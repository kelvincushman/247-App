{
  "expo": {
    "name": "247 Trades",
    "description": "Connect with verified tradespeople 24/7",
    "scheme": "247trades",
    "slug": "247trades",
    "privacy": "public",
    "version": "1.0.0",
    "platforms": ["android", "ios"],
    "orientation": "portrait",
    "primaryColor": "#0080FF",
    "icon": "src/assets/icon.png",
    "splash": {
      "backgroundColor": "#0080FF",
      "image": "src/assets/splash.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "versionCode": 1,
      "package": "com.yourcompany.trades247",
      "adaptiveIcon": {
        "foregroundImage": "src/assets/icon.png",
        "backgroundColor": "#0080FF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "googleServicesFile": "./google-services.json",
      "useNextNotificationsApi": true
    },
    "ios": {
      "buildNumber": "1.0.0",
      "bundleIdentifier": "com.yourcompany.trades247",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to find nearby tradespeople and show job locations.",
        "NSLocationAlwaysUsageDescription": "We need your location to track job progress and show accurate arrival times.",
        "NSCameraUsageDescription": "We need camera access to upload photos of your job.",
        "NSPhotoLibraryUsageDescription": "We need photo library access to upload images for your jobs.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ]
      }
    },
    "notification": {
      "icon": "src/assets/notification-icon.png",
      "color": "#0080FF",
      "androidMode": "default",
      "androidCollapsedTitle": "New notification from 247 Trades"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "src/assets/notification-icon.png",
          "color": "#0080FF",
          "sounds": []
        }
      ]
    ]
  }
}
