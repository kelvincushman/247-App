# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in actual values
# NEVER commit .env file to version control!

# Server Configuration
NODE_ENV=production
PORT=3000
API_VERSION=v1

# Database Configuration (PostgreSQL)
# Use connection string format for production
DATABASE_URL=postgresql://username:password@your-db-host.com:5432/trades_platform_prod
# OR use individual parameters:
# DB_HOST=your-production-db-host.com
# DB_PORT=5432
# DB_NAME=trades_platform_prod
# DB_USER=your_db_user
# DB_PASSWORD=your_secure_db_password

# JWT Configuration
# CRITICAL: Generate strong random secrets!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_RANDOM_64_CHAR_HEX_STRING
JWT_REFRESH_EXPIRE=30d

# Firebase Configuration (FCM for Push Notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Use escaped newlines for private key, or path to service account JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# OR use service account file path:
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json

# Stripe Configuration (Live Keys)
# IMPORTANT: Use LIVE keys (sk_live_..., whsec_...) in production
STRIPE_SECRET_KEY=sk_live_your_production_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_live_your_production_publishable_key
STRIPE_PLATFORM_FEE_PERCENTAGE=15

# AWS S3 Configuration (for file storage)
AWS_ACCESS_KEY_ID=your_production_aws_access_key
AWS_SECRET_ACCESS_KEY=your_production_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=trades-platform-prod-uploads
AWS_S3_MAX_FILE_SIZE=10485760

# Email Configuration (for transactional emails)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your_sendgrid_api_key
EMAIL_FROM=noreply@247trades.com
EMAIL_FROM_NAME=247 Trades Platform

# Redis Configuration (for caching, sessions, rate limiting)
REDIS_URL=redis://username:password@your-redis-host.com:6379
# OR use individual parameters:
# REDIS_HOST=your-redis-host.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_TLS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# CORS Configuration
# List allowed origins separated by comma
CORS_ORIGIN=https://your-app.com,https://www.your-app.com,https://app.your-domain.com

# Security
# Enable strict security headers in production
HELMET_ENABLED=true
TRUST_PROXY=true

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/combined.log
ERROR_LOG_FILE=logs/error.log

# Monitoring & APM (optional)
# NEW_RELIC_LICENSE_KEY=your_new_relic_key
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Feature Flags
ENABLE_SWAGGER_DOCS=false
ENABLE_DEBUG_LOGGING=false

# Payment Processing
PAYMENT_HOLD_PERIOD_HOURS=24
PLATFORM_COMMISSION_RATE=0.15

# Job Settings
MAX_JOB_IMAGES=5
MAX_JOB_SEARCH_RADIUS_KM=50

# Location Tracking
LOCATION_UPDATE_INTERVAL_SECONDS=5
AUTO_ARRIVAL_THRESHOLD_METERS=50

# Socket.io Configuration
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# Worker/Background Jobs (if using queue)
# REDIS_QUEUE_HOST=your-redis-host.com
# QUEUE_CONCURRENCY=10

# Health Check
HEALTH_CHECK_INTERVAL=30000

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# SSL/TLS
# If using SSL for database
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
